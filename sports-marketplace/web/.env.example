# ---------- Database ----------
# Local: any Postgres. Supabase: Project Settings > Database > Connection string.
#   DATABASE_URL = the "Transaction pooler" string (port 6543) with ?pgbouncer=true added
#   DIRECT_URL   = the "Session pooler" or direct string (port 5432)
DATABASE_URL="postgresql://rekit:rekit@localhost:5432/rekit"
DIRECT_URL="postgresql://rekit:rekit@localhost:5432/rekit"

# ---------- Supabase (production) ----------
# Project Settings > API. The service role key is secret: server only, never NEXT_PUBLIC.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Photos ----------
# "local" stores files in UPLOAD_DIR (development). "supabase" uses Supabase Storage.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
SUPABASE_BUCKET="listing-photos"
# Where browsers load photos from. Local: /uploads
# Supabase: https://<project>.supabase.co/storage/v1/object/public/listing-photos
NEXT_PUBLIC_PHOTO_BASE_URL="/uploads"

# ---------- SMS login ----------
# "dev" shows the code on screen and in the server log (refused in production).
# "supabase" sends real texts through Supabase Auth (set up an SMS provider in Supabase first).
SMS_DRIVER="dev"

# ---------- Site address and signing secret ----------
# Used in links inside emails. Required in production.
APP_URL="http://localhost:3000"
# Signs unsubscribe links. Required in production: at least 32 random characters
# (e.g. run: openssl rand -base64 48). Never share it or commit it.
APP_SECRET=""

# ---------- Email ----------
# "dev" saves each email as a file in OUTBOX_DIR instead of sending it (refused in production).
# "resend" sends through Resend (resend.com).
EMAIL_DRIVER="dev"
OUTBOX_DIR="./.outbox"
RESEND_API_KEY=""
# A sender on a domain you've verified in Resend, e.g. "ReKit <hello@rekit.ae>"
EMAIL_FROM=""

# ---------- Payments (advertising) ----------
# "dev" shows a pretend checkout page on this site (refused in production).
# "stripe" uses Stripe Checkout. Card details never touch our servers.
PAYMENT_DRIVER="dev"
STRIPE_SECRET_KEY=""
# From the webhook you create in Stripe (Developers > Webhooks), pointing at /api/payments/webhook
STRIPE_WEBHOOK_SECRET=""
