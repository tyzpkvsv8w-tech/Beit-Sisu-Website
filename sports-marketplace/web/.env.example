# ---------- Database ----------
# Local: any Postgres. Supabase: Project Settings > Database > Connection string.
#   DATABASE_URL = the "Transaction pooler" string (port 6543) with ?pgbouncer=true added
#   DIRECT_URL   = the "Session pooler" or direct string (port 5432)
DATABASE_URL="postgresql://rekit:rekit@localhost:5432/rekit"
DIRECT_URL="postgresql://rekit:rekit@localhost:5432/rekit"

# ---------- Supabase (production) ----------
# Project Settings > API. The service role key is secret: server only, never NEXT_PUBLIC.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Photos ----------
# "local" stores files in UPLOAD_DIR (development). "supabase" uses Supabase Storage.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
SUPABASE_BUCKET="listing-photos"
# Where browsers load photos from. Local: /uploads
# Supabase: https://<project>.supabase.co/storage/v1/object/public/listing-photos
NEXT_PUBLIC_PHOTO_BASE_URL="/uploads"

# ---------- SMS login ----------
# "dev" shows the code on screen and in the server log (refused in production).
# "supabase" sends real texts through Supabase Auth (set up an SMS provider in Supabase first).
SMS_DRIVER="dev"
