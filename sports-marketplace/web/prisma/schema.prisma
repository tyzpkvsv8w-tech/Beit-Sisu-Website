// ReKit database schema (Postgres: Supabase in production, any Postgres locally).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: the pooled connection (port 6543) for the app...
  url       = env("DATABASE_URL")
  // ...and the direct connection (port 5432) for migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  // Accounts sign up with a verified mobile number, an email + password, or both.
  email           String?   @unique
  passwordHash    String?
  name            String
  // E.164 format, e.g. +971501234567. Only set once verified by SMS code.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  showPhone       Boolean   @default(false)
  // "en" | "ar"
  locale          String    @default("en")
  // Emails only go to verified addresses. A new address waits in pendingEmail until confirmed.
  emailVerifiedAt DateTime?
  pendingEmail    String?
  notifyMessages  Boolean   @default(true)
  city         String?
  market       String   @default("ae")
  // "USER" or "ADMIN"
  role         String   @default("USER")
  // Shops and clubs that buy sponsored placements
  isBusiness   Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions      Session[]
  listings      Listing[]
  favorites     Favorite[]
  buying        Conversation[] @relation("buyer")
  selling       Conversation[] @relation("seller")
  messages      Message[]
  reports       Report[]
  emailTokens   EmailToken[]
  campaigns     AdCampaign[]
  orders        Order[]
  pushSubs      PushSubscription[]
}

model Session {
  // SHA-256 of the cookie token; the raw token is never stored
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  pushSubs  PushSubscription[]

  @@index([userId])
}

// A device that has turned on notifications. Tied to the login session, so logging out
// (or a password reset) stops notifications on that device.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // The push service URL the browser gave us, plus the keys used to encrypt messages for it
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

model Listing {
  id             String    @id @default(cuid())
  sellerId       String
  seller         User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  sport          String
  condition      String
  price          Int
  negotiable     Boolean   @default(true)
  brand          String?
  size           String?
  market         String    @default("ae")
  city           String
  area           String?
  // "ACTIVE" | "SOLD" | "REMOVED"
  status         String    @default("ACTIVE")
  // Set when a business pays to promote this listing
  sponsoredUntil DateTime?
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  photos        Photo[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]
  orders        Order[]

  @@index([market, status, sport])
  @@index([createdAt])
}

model Photo {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  key       String
  position  Int     @default(0)

  @@index([listingId])
}

model Favorite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User      @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([listingId, reporterId])
}

// One SMS login attempt: a code sent to a phone, checked at most 5 times.
model PhoneChallenge {
  id         String    @id @default(cuid())
  phone      String
  // Only used by the development SMS driver; Supabase keeps its own codes.
  codeHash   String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// Single-use links sent by email: password reset (1 hour) and email confirmation (24 hours).
model EmailToken {
  // SHA-256 of the token in the link; the raw token is never stored
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "reset" | "verify"
  purpose   String
  // The address being confirmed (verify only)
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// Display advertising sold to businesses
model AdCampaign {
  id          String   @id @default(cuid())
  advertiser  String
  headline    String
  body        String
  ctaLabel    String
  ctaUrl      String
  // "HOME_BANNER" | "SPORT_TAKEOVER" | "INFEED" | "LISTING_SIDE"
  placement   String
  // Optional targeting
  sport       String?
  city        String?
  market      String   @default("ae")
  startsAt    DateTime
  endsAt      DateTime
  // Pause switch for a live campaign
  active      Boolean  @default(true)
  // "PENDING_PAYMENT" | "IN_REVIEW" | "APPROVED" | "REJECTED" | "CANCELLED"
  // Only APPROVED campaigns are shown. Admin-created campaigns start as APPROVED.
  status      String   @default("APPROVED")
  // The business that booked it online (null for campaigns entered by the admin)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  reviewNote  String?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  orders      Order[]

  @@index([placement, market, active])
  @@index([status, placement, startsAt])
}

// A payment: an online ad booking, or promoting a listing. Amounts are in fils (AED x 100).
model Order {
  id                String      @id @default(cuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // "CAMPAIGN" | "PROMOTE"
  kind              String
  campaignId        String?
  campaign          AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  listingId         String?
  listing           Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  description       String
  weeks             Int
  subtotal          Int
  vat               Int
  total             Int
  currency          String      @default("aed")
  // "PENDING" | "PAID" | "CANCELLED" | "REFUNDED"
  status            String      @default("PENDING")
  provider          String
  providerSessionId String?     @unique
  providerPaymentId String?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime    @default(now())

  @@index([userId, createdAt])
}

model AdEnquiry {
  id        String   @id @default(cuid())
  name      String
  business  String
  email     String
  sport     String?
  budget    String?
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
