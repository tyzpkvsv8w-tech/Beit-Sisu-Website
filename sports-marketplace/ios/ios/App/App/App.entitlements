<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple push notifications. Xcode switches this to "production" for App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: rekit.ae links open in the app. Needs /.well-known/apple-app-site-association on the site. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rekit.ae</string>
		<string>applinks:www.rekit.ae</string>
	</array>
</dict>
</plist>
