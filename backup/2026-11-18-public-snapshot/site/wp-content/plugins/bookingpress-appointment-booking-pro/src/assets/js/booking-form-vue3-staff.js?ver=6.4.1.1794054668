/**
 * booking-form-vue3-staff.js — Pro "Staff Member" step for the Vue 3 booking form.
 *
 * WHAT IT DOES
 * ------------
 * Mounts the Staff Member step into the Lite `step:staff` slot (the generic
 * extra-step mount point App.js renders for any Pro-injected step). It lists the
 * staff members assigned to the SELECTED service — read from `state.pro_staff`
 * (server-embedded by {@see \BookingPressPro\Vue3\StaffMemberFeature}, no REST /
 * AJAX) and filtered client-side by `selected_service` — using the legacy
 * front-end card design (the `.bpa-front-sm-*` markup, styled by the isolated
 * `booking-form-vue3-staff.css`).
 *
 * Picking a staff stores `selected_staff_member_id` on the shared reactive state
 * and auto-advances (mirroring the Service step). Because the staff step carries
 * a `gate_field` in its descriptor, Lite's `canEnterStep()` already blocks the
 * following steps until a staff is chosen — so no Lite change is needed for the
 * gate. Changing the service clears the staff selection (Pro-owned reset; the
 * Lite Service step already clears the date/time).
 *
 * WHY IT LIVES IN PRO
 * -------------------
 * Lite owns only the generic step shell: it renders the sidebar entry + the
 * `step:staff` slot from the data-driven `state.steps`, and evaluates the
 * descriptor's `entry_gates` / `gate_field`. All staff-specific UI + behaviour
 * lives here. When the module is inactive the step is never injected and this
 * file is never enqueued, so a Lite-only / module-off render loads none of it.
 *
 * DELIVERY
 * --------
 * Enqueued as a script module by `StaffMemberFeature` (deps: the Lite loader +
 * `vue`). The side-effect import of the loader guarantees `window.BookingPressFormV3`
 * (+ instances + `renderInSlot`) exist before this runs.
 */

import 'bookingpress-form-v3-loader';
import { createApp, computed, ref, watch, onMounted, nextTick } from 'vue';

import { BookingPressUI } from 'bookingpress-ui';

// Reactive revision of the `bookingpress_form_v3_*` filter registry. When Staff
// is the FIRST step, this module mounts the step during its own evaluation —
// BEFORE sibling add-on modules (e.g. Ratings & Review) have run their
// `addFilter` calls. Seam computeds would then cache the empty default forever
// (applyFilters reads nothing reactive). `bpStaffHook` reads this ref, and
// wp.hooks fires `hookAdded` / `hookRemoved` on every registration, so a late
// add-on re-evaluates every seam computed.
const bpStaffHooksRevision = ref(0);
(function () {
  const hooks = (typeof window !== 'undefined' && window.wp && window.wp.hooks) || null;
  if (!hooks || typeof hooks.addAction !== 'function') return;
  const bump = (hookName) => {
    if (typeof hookName === 'string' && hookName.indexOf('bookingpress_form_v3_') === 0) {
      bpStaffHooksRevision.value++;
    }
  };
  hooks.addAction('hookAdded', 'bookingpress-pro/form-v3-staff-revision', bump);
  hooks.addAction('hookRemoved', 'bookingpress-pro/form-v3-staff-revision', bump);
})();

// --- Inline SVGs (legacy front-end parity) --------------------------------

