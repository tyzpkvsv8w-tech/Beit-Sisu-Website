var observer = new IntersectionObserver(
  function (entries, observer) {
    entries.forEach(function (entry) {
      var el = entry.target;
      if (entry.isIntersecting) {
        el.classList.add("animate");
        // Stop observing the element once it's animated
        observer.unobserve(el);
      }
    });
  },
  { threshold: 0.2 }
);

document.querySelectorAll(".animation").forEach(function (i) {
  observer.observe(i);
});

/*Header sticky script*/
document.addEventListener("DOMContentLoaded", function() {
  var headerDv = document.querySelector(".start-style");
  var lastScrollTop = 0;
  var scrollThreshold = 10; // Threshold to start hiding the header

  function updateHeaderPosition() {
      var scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > lastScrollTop && scrollTop > scrollThreshold) {
          // User is scrolling down and passed the threshold, hide the header
          headerDv.style.transform = 'translateY(-100%)'; // Slide up
      } else if (scrollTop < lastScrollTop) {
          // User is scrolling up, show the header
          headerDv.style.transform = 'translateY(0)'; // Slide down
      }

      lastScrollTop = scrollTop; // Update lastScrollTop
  }

  // Set initial position of header
  headerDv.style.transition = 'transform 0.3s ease-in-out';

  window.addEventListener("scroll", function() {
      updateHeaderPosition();
  }); 

// Back to top 
window.addEventListener("scroll", function () {
  var backToTopButton = document.getElementById("back-to-top");
  
  if (window.scrollY > 200) { // Show the button after scrolling 200px
    backToTopButton.classList.add('activate');
  } else {
    backToTopButton.classList.remove('activate');
  }
}); 

