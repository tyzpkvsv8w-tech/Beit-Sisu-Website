// Mobile Navigation
var navLink = document.getElementById('navLink');
var hamburgerLink = document.querySelector('.hamburger');
var mobileNavBg = document.querySelector('.mobile-nav-bg');
var menuPanel = document.getElementById('navbarSupportedContent');

navLink.addEventListener('click', function(event){ 
  menuPanel.classList.toggle("collapse");
  hamburgerLink.classList.toggle("is-active");
  mobileNavBg.classList.toggle("add-bg-white");
  event.preventDefault();
}); 


// Carousel Navigation
jQuery(function($) {
  var owl = $('.owl-carousel');
  owl.owlCarousel({
    stagePadding: 50,
    margin: 10,
    nav: true,
    loop: true,
    responsive: {
      0: {
        items: 1
      },
      600: {
        items: 2
      },
      1000: {
        items: 4
      },
      1400: {
        items: 5
      }
    }
  })
})

document.addEventListener('DOMContentLoaded', function () {
const galleryItems = document.querySelectorAll('.gallery-item');
const carouselItems = document.querySelectorAll('.carousel-item');

    galleryItems.forEach((item, index) => {
        item.addEventListener('click', () => {
        // Remove the active class from all carousel items
        carouselItems.forEach(carouselItem => carouselItem.classList.remove('active'));

        // Add active class to the clicked image in the carousel
        carouselItems[index].classList.add('active');
        });
    });
});


